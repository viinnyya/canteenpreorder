# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
DB_PATH=./db/canteen.db
# Students may only register with this email domain
ALLOWED_STUDENT_DOMAIN=my.cspc.edu.ph
# Used by db/setup.js to create the first admin account
SEED_ADMIN_EMAIL=admin@my.cspc.edu.ph
SEED_ADMIN_PASSWORD=change-me-before-demo
