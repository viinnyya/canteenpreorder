<%- include('../partials/header', { title: 'Sales' }) %>
<div class="page-head">
  <div>
    <h1 class="h3 mb-0">Sales</h1>
    <p class="text-muted mb-0"><%= stall.name %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/stall" class="btn btn-outline-secondary btn-sm">Back to dashboard</a>
    <a class="btn btn-primary btn-sm" href="/stall/sales/export.csv?from=<%= encodeURIComponent(filter.from) %>&amp;to=<%= encodeURIComponent(filter.to) %>">Download CSV</a>
  </div>
</div>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<div class="filter-bar">
  <ul class="nav nav-pills">
    <% presets.forEach(function (p) { %>
      <li class="nav-item"><a class="nav-link <%= (p.from === filter.from && p.to === filter.to) ? 'active' : '' %>"
        href="/stall/sales?from=<%= p.from %>&amp;to=<%= p.to %>"><%= p.label %></a></li>
    <% }) %>
  </ul>
  <form method="GET" action="/stall/sales" class="d-flex flex-wrap gap-2 align-items-end">
    <div><label class="form-label small mb-0" for="from">From</label>
      <input class="form-control form-control-sm" type="date" id="from" name="from" value="<%= filter.from %>"></div>
    <div><label class="form-label small mb-0" for="to">To</label>
      <input class="form-control form-control-sm" type="date" id="to" name="to" value="<%= filter.to %>"></div>
    <button class="btn btn-sm btn-outline-primary" type="submit">Apply</button>
  </form>
</div>
<p class="text-muted small">
  Sales count only orders whose payment you verified (accepted through picked up). Rejected, cancelled and unchecked orders are left out. Dates use Philippine time.
</p>

<div class="row g-3 mb-3">
  <div class="col-lg-5">
    <div class="card kpi kpi-hero h-100"><div class="card-body">
      <div class="kpi-label">Revenue</div>
      <div class="kpi-value"><%= peso(summary.revenue) %></div>
      <div class="kpi-note"><%= summary.orders %> paid order<%= summary.orders === 1 ? '' : 's' %></div>
    </div></div>
  </div>
  <div class="col-lg-7">
    <div class="row g-3 h-100">
      <div class="col-4"><div class="card kpi h-100"><div class="card-body">
        <div class="kpi-label">Paid orders</div><div class="kpi-value"><%= summary.orders %></div></div></div></div>
      <div class="col-4"><div class="card kpi h-100"><div class="card-body">
        <div class="kpi-label">Average order</div><div class="kpi-value"><%= peso(summary.average) %></div></div></div></div>
      <div class="col-4"><div class="card kpi h-100"><div class="card-body">
        <div class="kpi-label">Items sold</div><div class="kpi-value"><%= itemsSold %></div></div></div></div>
    </div>
  </div>
</div>

<% if (summary.orders === 0) { %>
  <div class="empty">
    <h2 class="h5">No verified sales in this period</h2>
    <p class="text-muted mb-3">Charts fill in as you accept payments. Try a longer period, or check the orders waiting for you.</p>
    <a href="/stall/orders" class="btn btn-primary btn-sm">Open incoming orders</a>
  </div>
<% } else { %>

<div class="card mb-3"><div class="card-body">
  <div class="chart-head">
    <h2 class="h5 mb-0">Daily sales</h2>
    <span class="text-muted small"><%= winLabel %></span>
  </div>
  <% if (win.truncated) { %><p class="text-muted small mb-0">Showing the last 31 days of the period you picked.</p><% } %>
  <%- include('../partials/chart-columns', { chart: dailyChart, label: 'Daily sales in pesos, ' + winLabel }) %>
  <details class="mt-3">
    <summary class="small text-muted">Show as table</summary>
    <table class="table table-sm mt-2 mb-0">
      <thead><tr><th>Date</th><th>Orders</th><th class="text-end">Revenue</th></tr></thead>
      <tbody>
        <% daily.slice().reverse().forEach(function (d) { %>
          <tr><td><%= d.day %></td><td><%= d.orders %></td><td class="text-end"><%= peso(d.revenue) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </details>
</div></div>

<div class="row g-3 mb-3">
  <div class="col-lg-7">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Best sellers</h2>
      <%- include('../partials/chart-bars', { rows: bestRows }) %>
    </div></div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Revenue by category</h2>
      <%- include('../partials/chart-bars', { rows: categoryRows }) %>
    </div></div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100"><div class="card-body">
      <div class="chart-head">
        <h2 class="h5 mb-0">Busiest hours</h2>
        <% if (busiestHour !== null) { %><span class="text-muted small">Peak around <%= (busiestHour % 12 === 0 ? 12 : busiestHour % 12) %> <%= busiestHour < 12 ? 'AM' : 'PM' %></span><% } %>
      </div>
      <p class="text-muted small mb-0">Paid orders by the hour they were placed. Staff up before the peak.</p>
      <%- include('../partials/chart-columns', { chart: hourChart, label: 'Paid orders by hour of the day' }) %>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">All orders by status</h2>
      <table class="table table-sm mb-0"><tbody>
        <% statuses.forEach(function (s) { %>
          <tr><td><%- include('../partials/status-badge', { status: s.status }) %></td><td class="text-end"><%= s.count %></td></tr>
        <% }) %>
      </tbody></table>
    </div></div>
  </div>
</div>
<% } %>
<%- include('../partials/footer') %>
