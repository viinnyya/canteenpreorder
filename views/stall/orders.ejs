<%- include('../partials/header', { title: 'Incoming orders', refresh: 15 }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Orders &middot; <%= stall.name %></h1>
  <a href="/stall" class="btn btn-outline-secondary btn-sm">Back to dashboard</a>
</div>

<ul class="nav nav-pills mb-2">
  <li class="nav-item"><a class="nav-link <%= tab === 'active' ? 'active' : '' %>" href="/stall/orders">Active</a></li>
  <li class="nav-item"><a class="nav-link <%= tab === 'all' ? 'active' : '' %>" href="/stall/orders?tab=all">All orders</a></li>
</ul>
<p class="text-muted small">This page refreshes every 15 seconds to show new orders.</p>

<% if (orders.length === 0) { %>
  <div class="alert alert-info">No orders here yet.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>#</th><th>Student</th><th>Placed</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><%= o.id %></td>
              <td><%= o.student_name %></td>
              <td><%= formatTime(o.created_at) %></td>
              <td><%= peso(o.total) %></td>
              <td><%- include('../partials/status-badge', { status: o.status }) %></td>
              <td class="text-end"><a href="/stall/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
<%- include('../partials/footer') %>
