<%- include('../partials/header', { title: 'Incoming orders', refresh: (tab === 'active' ? 15 : undefined) }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Orders &middot; <%= stall.name %></h1>
  <a href="/stall" class="btn btn-outline-secondary btn-sm">Back to dashboard</a>
</div>

<ul class="nav nav-pills mb-2">
  <li class="nav-item"><a class="nav-link <%= tab === 'active' ? 'active' : '' %>" href="/stall/orders">Active</a></li>
  <li class="nav-item"><a class="nav-link <%= tab === 'all' ? 'active' : '' %>" href="/stall/orders?tab=all">History &amp; search</a></li>
</ul>

<% if (tab === 'active') { %>
  <p class="text-muted small">Sorted by pickup time. This page refreshes every 15 seconds to show new orders.</p>
<% } else { %>
  <% if (errors.length) { %>
    <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="GET" action="/stall/orders" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="tab" value="all">
    <div class="col-md-3"><label class="form-label small mb-0" for="q">Search</label>
      <input class="form-control form-control-sm" id="q" name="q" maxlength="50" placeholder="Student, order #, reference" value="<%= filters.q %>"></div>
    <div class="col-md-2"><label class="form-label small mb-0" for="status">Status</label>
      <select class="form-select form-select-sm" id="status" name="status">
        <option value="">Any</option>
        <% Object.keys(orderStatus.LABELS).forEach(function (k) { %><option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= orderStatus.LABELS[k] %></option><% }) %>
      </select></div>
    <div class="col-md-2"><label class="form-label small mb-0" for="from">From</label>
      <input class="form-control form-control-sm" type="date" id="from" name="from" value="<%= filters.from %>"></div>
    <div class="col-md-2"><label class="form-label small mb-0" for="to">To</label>
      <input class="form-control form-control-sm" type="date" id="to" name="to" value="<%= filters.to %>"></div>
    <div class="col-md-3"><button class="btn btn-sm btn-primary" type="submit">Search</button>
      <a class="btn btn-sm btn-outline-secondary" href="/stall/orders?tab=all">Clear</a></div>
  </form>
  <p class="text-muted small"><%= total %> order<%= total === 1 ? '' : 's' %> found.</p>
<% } %>

<% if (orders.length === 0) { %>
  <div class="alert alert-info">No orders here yet.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>#</th><th>Student</th><th>Placed</th><th>Pickup</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><%= o.id %></td>
              <td><%= o.student_name %></td>
              <td><%= formatTime(o.created_at) %></td>
              <td><%= formatPickup(o.pickup_time) %></td>
              <td><%= peso(o.total) %></td>
              <td><%- include('../partials/status-badge', { status: o.status }) %></td>
              <td class="text-end"><a href="/stall/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (tab === 'all' && pages > 1) {
       var qs = 'tab=all&q=' + encodeURIComponent(filters.q) + '&status=' + encodeURIComponent(filters.status) + '&from=' + filters.from + '&to=' + filters.to; %>
    <nav class="mt-3 d-flex gap-2 align-items-center">
      <% if (page > 1) { %><a class="btn btn-sm btn-outline-secondary" href="/stall/orders?<%= qs %>&page=<%= page - 1 %>">&larr; Newer</a><% } %>
      <span class="small text-muted">Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %><a class="btn btn-sm btn-outline-secondary" href="/stall/orders?<%= qs %>&page=<%= page + 1 %>">Older &rarr;</a><% } %>
    </nav>
  <% } %>
<% } %>
<%- include('../partials/footer') %>
