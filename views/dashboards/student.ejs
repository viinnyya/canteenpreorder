<%- include('../partials/header', { title: 'Student' }) %>
<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="h3 mb-0">Welcome, <%= user.name %></h1>
  <a href="/orders" class="btn btn-outline-primary btn-sm">My orders</a>
</div>
<p class="text-muted">Pick a stall to start a pre-order.</p>
<div class="row g-3">
  <% stalls.forEach(function (s) { %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
          <h2 class="h5"><%= s.name %></h2>
          <p class="text-muted"><%= s.description || '' %></p>
          <a href="/stalls/<%= s.id %>" class="btn btn-primary mt-auto">View menu and order</a>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (stalls.length === 0) { %>
    <p class="text-muted">No stalls yet. An administrator needs to add one.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>