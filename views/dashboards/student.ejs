<%- include('../partials/header', { title: 'Student' }) %>
<h1 class="h3 mb-1">Welcome, <%= user.name %></h1>
<p class="text-muted">Pick a stall to start a pre-order.</p>
<div class="row g-3">
  <% stalls.forEach(function (s) { %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h2 class="h5"><%= s.name %></h2>
          <p class="text-muted mb-0"><%= s.description || '' %></p>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (stalls.length === 0) { %>
    <p class="text-muted">No stalls yet. An administrator needs to add one.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
