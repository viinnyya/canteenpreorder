<%- include('../partials/header', { title: 'Stall' }) %>
<h1 class="h3 mb-1">Stall dashboard</h1>
<% if (stall) { %>
  <p class="text-muted"><%= stall.name %> &middot; <%= stall.description || '' %></p>
  <div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Orders today</div><div class="fs-3"><%= summary.orders_today || 0 %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Verified sales today</div><div class="fs-3"><%= peso(summary.revenue_today) %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Payments to check</div><div class="fs-3 <%= summary.to_verify ? 'text-danger' : '' %>"><%= summary.to_verify || 0 %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Active orders</div><div class="fs-3"><%= summary.active || 0 %></div></div></div></div>
  </div>
  <div class="row g-3">
    <div class="col-md-4">
      <div class="card shadow-sm h-100"><div class="card-body d-flex flex-column">
        <h2 class="h5">Menu</h2>
        <p class="text-muted">Add items, change prices, and mark things unavailable.</p>
        <a href="/stall/menu" class="btn btn-primary mt-auto">Manage menu</a>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100"><div class="card-body d-flex flex-column">
        <h2 class="h5">Orders</h2>
        <p class="text-muted">Check payments and move orders through preparation.</p>
        <a href="/stall/orders" class="btn btn-primary mt-auto">Incoming orders</a>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100"><div class="card-body d-flex flex-column">
        <h2 class="h5">Sales</h2>
        <p class="text-muted">Revenue, best sellers and your busiest hours.</p>
        <a href="/stall/sales" class="btn btn-primary mt-auto">View sales</a>
      </div></div>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-warning">No stall is linked to this account yet. Ask an administrator.</div>
<% } %>
<%- include('../partials/footer') %>
