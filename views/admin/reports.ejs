<%- include('../partials/header', { title: 'Sales reports' }) %>
<h1 class="h3 mb-3">Admin</h1>
<%- include('_tabs', { active: 'reports' }) %>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="GET" action="/admin/reports" class="row g-2 align-items-end mb-3">
  <div class="col-auto"><label class="form-label small mb-0" for="from">From</label>
    <input class="form-control form-control-sm" type="date" id="from" name="from" value="<%= filter.from %>"></div>
  <div class="col-auto"><label class="form-label small mb-0" for="to">To</label>
    <input class="form-control form-control-sm" type="date" id="to" name="to" value="<%= filter.to %>"></div>
  <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit">Apply</button>
    <a class="btn btn-sm btn-outline-secondary" href="/admin/reports">All time</a>
    <a class="btn btn-sm btn-outline-primary" href="/admin/reports/export.csv?from=<%= encodeURIComponent(filter.from) %>&to=<%= encodeURIComponent(filter.to) %>">Download sales (CSV)</a></div>
</form>
<p class="text-muted small">Sales count only orders whose payment a stall has verified (accepted through picked up). Rejected and unchecked orders are excluded. Dates use Philippine time.</p>

<div class="row g-3 mb-3">
  <div class="col-sm-4"><div class="card kpi kpi-hero h-100"><div class="card-body">
    <div class="kpi-label">Revenue</div><div class="kpi-value"><%= peso(summary.revenue) %></div></div></div></div>
  <div class="col-sm-4"><div class="card kpi h-100"><div class="card-body">
    <div class="kpi-label">Paid orders</div><div class="kpi-value"><%= summary.orders %></div></div></div></div>
  <div class="col-sm-4"><div class="card kpi h-100"><div class="card-body">
    <div class="kpi-label">Average order</div><div class="kpi-value"><%= peso(summary.average) %></div></div></div></div>
</div>

<div class="card mb-3"><div class="card-body">
  <div class="chart-head">
    <h2 class="h5 mb-0">Daily sales, all stalls</h2>
    <span class="text-muted small"><%= winLabel %></span>
  </div>
  <% if (win.truncated) { %><p class="text-muted small mb-0">Showing the last 31 days of the period you picked.</p><% } %>
  <%- include('../partials/chart-columns', { chart: dailyChart, label: 'Daily sales in pesos, all stalls, ' + winLabel }) %>
</div></div>

<div class="row g-3 mb-3">
  <div class="col-lg-7">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Best-selling items</h2>
      <% if (bestRows.length === 0) { %><p class="text-muted mb-0">No paid orders in this period.</p><% } else { %>
        <%- include('../partials/chart-bars', { rows: bestRows }) %>
      <% } %>
    </div></div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Sales per stall</h2>
      <% if (stallRows.length === 0) { %><p class="text-muted mb-0">No stalls yet.</p><% } else { %>
        <%- include('../partials/chart-bars', { rows: stallRows }) %>
      <% } %>
    </div></div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">Busiest hours</h2>
      <p class="text-muted small mb-0">Paid orders by the hour they were placed, all stalls.</p>
      <%- include('../partials/chart-columns', { chart: hourChart, label: 'Paid orders by hour of the day, all stalls' }) %>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h5">All orders by status</h2>
      <table class="table table-sm mb-0"><tbody>
        <% statuses.forEach(function (s) { %><tr><td><%- include('../partials/status-badge', { status: s.status }) %></td><td class="text-end"><%= s.count %></td></tr><% }) %>
        <% if (statuses.length === 0) { %><tr><td class="text-muted">No orders yet.</td></tr><% } %>
      </tbody></table>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
