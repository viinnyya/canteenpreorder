<%- include('../partials/header', { title: 'Sales reports' }) %>
<h1 class="h3 mb-3">Admin</h1>
<%- include('_tabs', { active: 'reports' }) %>

<% if (errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="GET" action="/admin/reports" class="row g-2 align-items-end mb-3">
  <div class="col-auto"><label class="form-label small mb-0" for="from">From</label>
    <input class="form-control form-control-sm" type="date" id="from" name="from" value="<%= filter.from %>"></div>
  <div class="col-auto"><label class="form-label small mb-0" for="to">To</label>
    <input class="form-control form-control-sm" type="date" id="to" name="to" value="<%= filter.to %>"></div>
  <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit">Apply</button>
    <a class="btn btn-sm btn-outline-secondary" href="/admin/reports">All time</a></div>
</form>
<p class="text-muted small">Sales count only orders whose payment a stall has verified (accepted through picked up). Rejected and unchecked orders are excluded. Dates use Philippine time.</p>

<div class="row g-3 mb-3">
  <div class="col-sm-4"><div class="card shadow-sm"><div class="card-body">
    <div class="text-muted small">Revenue</div><div class="fs-3"><%= peso(summary.revenue) %></div></div></div></div>
  <div class="col-sm-4"><div class="card shadow-sm"><div class="card-body">
    <div class="text-muted small">Paid orders</div><div class="fs-3"><%= summary.orders %></div></div></div></div>
  <div class="col-sm-4"><div class="card shadow-sm"><div class="card-body">
    <div class="text-muted small">Average order</div><div class="fs-3"><%= peso(summary.average) %></div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h2 class="h5">Best-selling items</h2>
      <% if (best.length === 0) { %><p class="text-muted mb-0">No paid orders in this period.</p><% } else { %>
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>#</th><th>Item</th><th>Stall</th><th style="width:30%">Sold</th><th class="text-end">Revenue</th></tr></thead>
        <tbody>
          <% best.forEach(function (b, i) { %>
            <tr><td><%= i + 1 %></td><td><%= b.item %></td><td class="text-muted"><%= b.stall %></td>
              <td><div class="d-flex align-items-center gap-2">
                <div class="progress flex-grow-1" style="height:8px"><div class="progress-bar" style="width:<%= Math.round(b.sold / maxSold * 100) %>%"></div></div>
                <span><%= b.sold %></span></div></td>
              <td class="text-end"><%= peso(b.revenue) %></td></tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div></div>
  </div>
  <div class="col-lg-5">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h2 class="h5">Sales per stall</h2>
      <table class="table table-sm mb-0">
        <thead><tr><th>Stall</th><th>Orders</th><th class="text-end">Revenue</th></tr></thead>
        <tbody>
          <% stalls.forEach(function (s) { %><tr><td><%= s.stall %></td><td><%= s.orders %></td><td class="text-end"><%= peso(s.revenue) %></td></tr><% }) %>
        </tbody>
      </table>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h2 class="h5">Busiest hours</h2>
      <% if (hours.length === 0) { %><p class="text-muted mb-0">No data.</p><% } else { %>
      <table class="table table-sm mb-0"><thead><tr><th>Hour</th><th>Orders</th></tr></thead><tbody>
        <% hours.forEach(function (h) { %><tr><td><%= String(h.hour).padStart(2, '0') %>:00</td><td><%= h.orders %></td></tr><% }) %>
      </tbody></table><% } %>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h2 class="h5">Daily sales (last 14 days)</h2>
      <% if (days.length === 0) { %><p class="text-muted mb-0">No data.</p><% } else { %>
      <table class="table table-sm mb-0"><thead><tr><th>Date</th><th>Orders</th><th class="text-end">Revenue</th></tr></thead><tbody>
        <% days.forEach(function (d) { %><tr><td><%= d.day %></td><td><%= d.orders %></td><td class="text-end"><%= peso(d.revenue) %></td></tr><% }) %>
      </tbody></table><% } %>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100"><div class="card-body">
      <h2 class="h5">All orders by status</h2>
      <table class="table table-sm mb-0"><tbody>
        <% statuses.forEach(function (s) { %><tr><td><%= orderStatus.LABELS[s.status] || s.status %></td><td class="text-end"><%= s.count %></td></tr><% }) %>
        <% if (statuses.length === 0) { %><tr><td class="text-muted">No orders yet.</td></tr><% } %>
      </tbody></table>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
