<%- include('../partials/header', { title: 'Stall accounts' }) %>
<h1 class="h3 mb-3">Admin</h1>
<%- include('_tabs', { active: 'stalls' }) %>

<% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>
<% if (errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>

<div class="row g-3">
  <div class="col-lg-5">
    <div class="card shadow-sm"><div class="card-body">
      <h2 class="h5">Create a stall account</h2>
      <p class="text-muted small">Only admins can do this. Give the login details to the stall owner.</p>
      <form method="POST" action="/admin/stalls" autocomplete="off">
        <div class="mb-2">
          <label class="form-label" for="name">Stall name</label>
          <input class="form-control" id="name" name="name" maxlength="40" required value="<%= values.name || '' %>">
        </div>
        <div class="mb-2">
          <label class="form-label" for="description">Description</label>
          <input class="form-control" id="description" name="description" maxlength="120" value="<%= values.description || '' %>">
        </div>
        <div class="mb-2">
          <label class="form-label" for="gcashNumber">GCash number</label>
          <input class="form-control" type="tel" id="gcashNumber" name="gcashNumber" inputmode="numeric" placeholder="09XXXXXXXXX" maxlength="16" required value="<%= values.gcashNumber || '' %>">
          <div class="form-text">Students send their payment to this number.</div>
        </div>
        <div class="mb-2">
          <label class="form-label" for="email">Login email</label>
          <input class="form-control" type="email" id="email" name="email" required value="<%= values.email || '' %>">
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Temporary password</label>
          <input class="form-control" type="password" id="password" name="password" minlength="8" maxlength="72" required>
        </div>
        <button class="btn btn-primary" type="submit">Create stall</button>
      </form>
    </div></div>
  </div>
  <div class="col-lg-7">
    <div class="card shadow-sm"><div class="card-body">
      <h2 class="h5">Stalls</h2>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Stall</th><th>Login email</th><th>Orders</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
          <tbody>
            <% stalls.forEach(function (s) { %>
              <tr class="<%= s.active ? '' : 'table-secondary' %>">
                <td><strong><%= s.name %></strong><br><span class="text-muted small"><%= s.description || '' %></span><br><span class="small">GCash: <%= s.gcash_number || '—' %></span></td>
                <td><%= s.email %></td>
                <td><%= s.order_count %></td>
                <td><span class="badge text-bg-<%= s.active ? 'success' : 'secondary' %>"><%= s.active ? 'Active' : 'Removed' %></span></td>
                <td class="text-end">
                  <details class="d-inline-block text-start me-1">
                    <summary class="btn btn-sm btn-outline-secondary">Menu CSV</summary>
                    <div class="border rounded p-2 mt-1 bg-body" style="min-width:260px">
                      <a class="btn btn-sm btn-outline-primary mb-2" href="/admin/stalls/<%= s.id %>/menu.csv">Download menu</a>
                      <form method="POST" action="/admin/stalls/<%= s.id %>/menu-import" enctype="multipart/form-data" class="m-0">
                        <input type="file" name="file" accept=".csv,text/csv" class="form-control form-control-sm mb-1" required>
                        <button class="btn btn-sm btn-primary">Import into this stall</button>
                      </form>
                    </div>
                  </details>
                  <% if (s.active) { %>
                    <form method="POST" action="/admin/stalls/<%= s.id %>/remove" class="d-inline"
                          data-msg="Remove <%= s.name %>? Its login will be disabled and students will no longer see it."
                          onsubmit="return confirm(this.dataset.msg);">
                      <button class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/admin/stalls/<%= s.id %>/restore" class="d-inline"><button class="btn btn-sm btn-success">Restore</button></form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (stalls.length === 0) { %><tr><td colspan="5" class="text-muted">No stalls yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div></div>
  </div>
</div>
<%- include('../partials/footer') %>
