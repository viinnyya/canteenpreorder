<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (typeof refresh !== 'undefined') { %><meta http-equiv="refresh" content="<%= refresh %>"><% } %>
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Canteen Pre-Order</title>
  <script>
    // Apply the saved (or system) theme before the page paints, so there is no flash.
    (function () {
      var theme = null;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-bs-theme', theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="topbar mb-4">
  <div class="container topbar-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M3 12h18a9 9 0 0 1-18 0z" fill="currentColor"/><path d="M8 8.5c0-2 2-2 2-4M13 8.5c0-2 2-2 2-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </span>
      <span class="brand-text">Canteen <span>pre-order</span></span>
    </a>
    <div class="topbar-actions">
      <% if (user) { %>
        <span class="who"><%= user.name %></span>
        <span class="role-pill"><%= user.role %></span>
        <a class="topbar-link" href="/account">Account</a>
      <% } else { %>
        <a class="topbar-link" href="/login">Log in</a>
        <a class="topbar-link" href="/register">Register</a>
      <% } %>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between light and dark mode">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg>
      </button>
      <% if (user) { %>
        <form method="POST" action="/logout" class="m-0">
          <button type="submit" class="btn btn-sm btn-logout">Log out</button>
        </form>
      <% } %>
    </div>
  </div>
</nav>
<main class="container pb-5">
